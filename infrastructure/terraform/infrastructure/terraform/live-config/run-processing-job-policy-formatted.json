{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ManageSageMakerProcessingJobs",
            "Effect": "Allow",
            "Action": [
                "sagemaker:CreateProcessingJob",
                "sagemaker:DescribeProcessingJob",
                "sagemaker:StopProcessingJob",
                "sagemaker:AddTags"
            ],
            "Resource": "*"
        },
        {
            "Sid": "PassSageMakerExecutionRole",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::975050327570:role/AmazonSageMakerExecutionRole-GeneEditRanking",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "sagemaker.amazonaws.com"
                }
            }
        },
        {
            "Sid": "ManageStepFunctionEvents",
            "Effect": "Allow",
            "Action": [
                "events:PutTargets",
                "events:PutRule",
                "events:DescribeRule"
            ],
            "Resource": "*"
        }
    ]
}
